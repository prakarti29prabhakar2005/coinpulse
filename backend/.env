PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coinpulse

# Optional CoinGecko API key for crypto price checks.
COINGECKO_API_KEY=

# SMTP is optional. If omitted, alerts still appear in the web app,
# but email delivery will be skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
